# ============================================================
# .env.example — Copy this to .env and fill in your real values.
# NEVER commit .env to GitHub — it is listed in .gitignore.
# ============================================================

# Web3Forms access key (get one free at https://web3forms.com)
WEB3FORMS_ACCESS_KEY=YOUR_WEB3FORMS_KEY_HERE

# ntfy.sh topic (choose a long, hard-to-guess name for privacy)
NTFY_TOPIC=YOUR_PRIVATE_NTFY_TOPIC_HERE
